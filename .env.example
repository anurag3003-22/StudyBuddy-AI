# ── LangGraph agent service ──────────────────────────────────────────────
# Works with any OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, Ollama).
# Leave the key empty to run the deterministic offline agents.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Optional: enables hybrid (semantic + BM25) retrieval
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=

CORS_ORIGINS=*
HOST=0.0.0.0
PORT=8000
